+// 012 probe: measure the VRAM a CUDA graph capture holds. GGML_CUDA_GRAPH_PROBE=1
+#ifdef USE_CUDA_GRAPH
+static std::atomic<int> ggml_cuda_graph_probe_captures = 0;
+
+static void ggml_cuda_graph_probe_log(const char * where, const void * key, int n_nodes) {
+    static const bool enable = getenv("GGML_CUDA_GRAPH_PROBE") != nullptr && std::atoi(getenv("GGML_CUDA_GRAPH_PROBE"));
+    if (!enable) {
+        return;
+    }
+    size_t probe_free = 0;
+    size_t probe_total = 0;
+    if (cudaMemGetInfo(&probe_free, &probe_total) != cudaSuccess) {
+        (void)cudaGetLastError();
+        return;
+    }
+    GGML_LOG_INFO("graph-probe: %s free = %8.1f MiB, captures = %d, key = %p, nodes = %d\n", where,
+                  probe_free / (1024.0*1024.0), ggml_cuda_graph_probe_captures.load(std::memory_order_relaxed),
+                  key, n_nodes);
+}
+#endif // USE_CUDA_GRAPH
+
 static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, const bool use_cuda_graph, const bool cuda_graph_update_required, const void * graph_key) {
     bool graph_evaluated_or_captured = false;
 
