+// the lookahead path trades CUDA graphs for bulk DMA: worth it only when the managed
+// footprint actually spills past VRAM, so gate on that (spec 011)
+static bool ggml_cuda_uvm_prefetch_active(int device) {
+    if (!ggml_cuda_uvm_prefetch_enabled()) {
+        return false;
+    }
+    const size_t total = ggml_cuda_info().devices[device].total_vram;
+    const size_t managed = ggml_cuda_managed_bytes[device].load(std::memory_order_relaxed);
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        GGML_LOG_ERROR("UVMDBG active check: managed %zu MiB total %zu MiB -> %s\n",
+                managed >> 20, total >> 20, managed > (size_t)(0.9 * (double) total) ? "ON" : "off");
+    }
+    return managed > (size_t)(0.9 * (double) total);
+}
