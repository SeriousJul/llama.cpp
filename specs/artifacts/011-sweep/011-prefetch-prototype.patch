+// decode-shaped cgraph: FA nodes carry <=16 tokens (tg or short verify batch).
+// lookahead prefetch and its graph trade only make sense for decode graphs.
+static bool ggml_cuda_cgraph_is_decode(ggml_cgraph * cgraph) {
+    // FA q rows = heads x tokens: 24 x 1..8 on decode/verify vs 24 x 512 on pp
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node->op == GGML_OP_FLASH_ATTN_EXT && node->src[0] != nullptr && ggml_nrows(node->src[0]) > 1024) {
+            return false;
+        }
+    }
+    return true;
+}
