+// stage the src tensors of the nodes up to W ahead onto the device, on the compute
+// stream, just before the current node runs: bulk just-in-time DMA instead of the
+// fault storm at the VRAM overflow cliff (spec 011)
+static void ggml_cuda_uvm_prefetch_ahead(
+        ggml_backend_cuda_context * cuda_ctx,
+        const ggml_cgraph * cgraph,
+        int i,
+        std::unordered_set<const void *> & staged) {
+    constexpr int W = 64;  // ~one decoder layer of nodes in the tg graph
+
+    static_assert(GGML_MAX_DIMS == 4, "row-stride scan below assumes 4 dims");
+
+    const int phys_dev = ggml_cuda_get_physical_device(cuda_ctx->device);
+
+    for (int j = i + 1; j <= i + W && j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = node->src[s];
+            if (src == nullptr || src->buffer == nullptr || !ggml_backend_buffer_is_cuda(src->buffer)) {
+                continue;
+            }
+            if (node->op == GGML_OP_SET_ROWS) {
+                // the large srcs are full-capacity cache destinations: row stores
+                // touch a few KB of active cells, demand paging is cheaper than staging
+                continue;
+            }
+            const ggml_backend_cuda_buffer_context * bctx =
+                (const ggml_backend_cuda_buffer_context *) src->buffer->context;
+            if (!bctx->is_managed || !staged.insert(src->data).second) {
+                continue;
+            }
+
+            size_t nbytes = ggml_nbytes(src);
+            if (node->op == GGML_OP_FLASH_ATTN_EXT && (s == 1 || s == 2)) {
+                // KV views span the full cache capacity: stage only the used prefix
+                const int32_t n_kv_max = ggml_get_op_params_i32(node, 4);
+                int d_cells = 1;
+                for (int d = 2; d < GGML_MAX_DIMS; d++) {
+                    if (src->ne[d] > 1 && src->nb[d] > src->nb[d_cells]) {
+                        d_cells = d;
+                    }
+                }
+                if (n_kv_max > 0 && src->ne[d_cells] >= (int64_t) n_kv_max) {
+                    nbytes = (size_t) n_kv_max * src->nb[d_cells];
+                }
+            }
+#if CUDART_VERSION >= 12080
+            cudaMemLocation loc;
+            loc.type = cudaMemLocationTypeDevice;
+            loc.id   = phys_dev;
+            (void)cudaMemPrefetchAsync(src->data, nbytes, loc, /* flags */ 0, cuda_ctx->stream());
+#else
+            (void)cudaMemPrefetchAsync(src->data, nbytes, phys_dev, cuda_ctx->stream());
+#endif
+            (void)cudaGetLastError(); // best effort: a failed prefetch cannot break the graph
+
+        }
+    }
+}
